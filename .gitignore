# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_cache*/
.pytest_tmp*/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
.ipython/
.jupyter/*
!.jupyter/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Environment and credentials
.env
*.pem
*.key

# Data products: manifests and small fixtures may be committed explicitly
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Local databases and FastF1 cache
*.duckdb
*.duckdb.wal
data/cache/
data/manual/full_corpus_workspaces/
data/manual/full_corpus_first_pass/
data/manual/full_corpus_exception_packets/
data/manual/full_corpus_review_edits/
data/manual/full_corpus_review_rounds/

# Generated reports
reports/generated/**
!reports/generated/.gitkeep

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
